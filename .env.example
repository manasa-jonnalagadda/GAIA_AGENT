# API key for the LLM provider (OpenAI, Anthropic, etc.)
LLM_API_KEY=your_api_key_here

# Model ID to use (default is gpt-4o)
# E.g., gpt-4o, claude-3-5-sonnet-latest, gemini/gemini-2.5-flash
LLM_MODEL_ID=gpt-4o

# Optional: set TEST_MODE=true to run in test mode (first 3 questions only)
TEST_MODE=false
